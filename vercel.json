{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",

  "routes": [
    {
      "src": "/.well-known/apple-app-site-association",
      "dest": "/.well-known/apple-app-site-association"
    },
    {
      "src": "/.well-known/assetlinks.json",
      "dest": "/.well-known/assetlinks.json"
    },

    {
  "src": "/app/trip/invite/([a-f0-9]{64})/?",
  "dest": "/api/trip-invite?token=$1"
},
{
  "handle": "filesystem"
},
{
  "src": "/app/trip/invite/[^/]+/?",
  "dest": "/index.html"
},

    {
      "src": "/app(?:/.*)?",
      "dest": "/app/index.html"
    },

    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ],

  "headers": [
    {
      "source": "/.well-known/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ]
}